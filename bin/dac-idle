#!/bin/sh
# dac-idle - power off after IDLE_SHUTDOWN_MINUTES with no audio playing.
#
# For installs without the NESPi case (the case has its own power path in nespi-power).
# "Playing" means an ALSA playback stream is RUNNING, so paused or stopped music counts as idle.
# The timer starts at boot, so a Pi that never plays anything also powers off.
set -u
[ -f /etc/spotify-dac/config ] && . /etc/spotify-dac/config
LIMIT=$(( ${IDLE_SHUTDOWN_MINUTES:-0} * 60 ))
[ "$LIMIT" -gt 0 ] || exit 0

playing() {
  grep -q "state: RUNNING" /proc/asound/card*/pcm*p/sub*/status 2>/dev/null
}

last=$(date +%s)
while sleep 30; do
  if playing; then last=$(date +%s); fi
  idle=$(( $(date +%s) - last ))
  if [ "$idle" -ge "$LIMIT" ]; then
    echo "dac-idle: no playback for $(( idle / 60 )) min, powering off"
    systemctl poweroff
    exit 0
  fi
done

# Answers file for unattended installs:  sudo ./install.sh --config my.conf
# Copy to my.conf (gitignored), fill in, keep it private - it holds your API key.

DEVICE_NAME="Living Room"

# What this box plays: Spotify (Soloist, needs the API key below) and/or internet radio
# (the station list lives in the web interface, so radio needs WEB_UI="yes").
SPOTIFY_ENABLED="yes"
RADIO_ENABLED="yes"
# AirPlay receiver (shairport-sync). Off by default; the Home page starts and stops it, never at boot.
AIRPLAY_ENABLED="no"

# Wi-Fi hotspot "volodymyr-pi-dac-2" (the device name): starts when there is no network, or by holding reset 5 s.
# Off by default. The password is set in the installer or on the Wi-Fi page (never stored here).
HOTSPOT_ENABLED="no"
HOTSPOT_FALLBACK_SECONDS="60"        # 60-300: seconds without any network before the hotspot starts

# Sound card: usb = USB DAC (Topping E30 ...), hat = I2S/S-PDIF HAT (set the overlay)
AUDIO_OUTPUT="usb"
AUDIO_HAT_OVERLAY=""                # iqaudio-dacplus | hifiberry-dacplus (also PiFi DAC+) | hifiberry-dac | hifiberry-digi (PiFi Digi+)

# Case: nespi = RetroFlag NESPi Case+, none. Only with a USB card - a HAT takes
# the GPIO pins, so CASE and FAN_ENABLED are forced off for any HAT.
CASE="nespi"
FAN_ENABLED="yes"
# yes: the power switch and buttons work (safe shutdown) | no: the case stays powered, switch ignored
SAFE_SHUTDOWN="yes"

# Updates (NESPi only): poweroff | boot | none (only when the build expired)
# Without the case this is always "boot" - there is no power switch to hook.
UPDATE_TRIGGER="poweroff"
SOLOIST_UPDATE_AFTER_DAYS="45"      # 1-89, builds expire after 90 days
APT_UPGRADE="yes"
APT_UPGRADE_AFTER_DAYS="0"          # 0 = every time the update runs

# Shared volume used until a level is first set (0-100)
DEFAULT_VOLUME="25"

# Web interface: HTTPS on WEB_PORT, for the Home, Radio, Status and Settings pages
WEB_UI="yes"
WEB_PORT="8443"
WEB_USE_PASSWORD="yes"              # no: anyone on your network can change the settings
WEB_PASSWORD=""                     # read from this file only; the web UI stores a hash

# From https://developer.spotify.com (Soloist API key, needs Spotify Premium)
SOLOIST_API_KEY=""

# --- Example: second box with an IQaudIO DAC+ HAT ---
# DEVICE_NAME="Kitchen"
# AUDIO_OUTPUT="hat"
# AUDIO_HAT_OVERLAY="iqaudio-dacplus"
# CASE="none"                        # -> updates always at boot
# APT_UPGRADE_AFTER_DAYS="7"

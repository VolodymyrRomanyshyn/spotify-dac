[Unit]
Description=Spotify DAC: Bluetooth pairing agent (answers pairing with the PIN from the installer)
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/bt-agent -c DisplayOnly -p /etc/spotify-dac/bluetooth.pin
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=Spotify DAC: Bluetooth pairing agent (shows the 6-digit code; confirmed on the Settings page)
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/dac-bt-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
